# Copy to .env (or just run python3 ecs.py setup, which does it for you and fills in secrets).

# The address people type to reach your site, with no trailing slash.
#   Local test:  http://localhost:5000
#   Real site:   https://example.com
PUBLIC_URL=http://localhost:5000

# Only used with python3 ecs.py start --https. Must point (DNS A record) at this server.
DOMAIN=

# Port the website listens on. HTTP_BIND=0.0.0.0 exposes it directly; 127.0.0.1 keeps it private
# (use that when something else, like the bundled Caddy, sits in front).
HTTP_BIND=127.0.0.1
HTTP_PORT=5000

# Set by ecs.py. 1 = also run the Caddy HTTPS proxy.
HTTPS_ENABLED=0

# Password for the owner/admin account (username: ROBLOX). Used the first time the site starts.
OWNER_PASSWORD=

# Generated by python3 ecs.py setup. Keep these private and never change POSTGRES_PASSWORD after first start.
POSTGRES_PASSWORD=
JWT_SECRET=
CSRF_KEY=
INTERNAL_AUTH=

# Optional: real hCaptcha keys (https://www.hcaptcha.com). Leave empty to run without captchas.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
